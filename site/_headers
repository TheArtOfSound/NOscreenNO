# Cloudflare Pages headers. Serve the APK as a real package download so phones
# offer to install it directly and desktops save it cleanly.
/NOscreenNO.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="NOscreenNO.apk"
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff
